# ---------------------------------------------------------------
# MR ROKESH Authenticator — backend configuration
# Generate JWT keys, AES key and company API key with:
#   npm run gen:secrets
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Set to the number of proxy hops in front of the API (e.g. 1 behind Railway/Render/Nginx)
TRUST_PROXY=0

# REQUIRED — PostgreSQL connection string (Supabase / Railway / Neon / local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mr_rokesh_auth?schema=public

# REQUIRED — comma-separated origins allowed by CORS (admin dashboard URL(s))
CORS_ORIGINS=http://localhost:5173

# REQUIRED — RS256 keypair (PEM). Newlines may be written as \n on one line.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=mr-rokesh-authenticator
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# REQUIRED — 32-byte AES-256-GCM key, base64 encoded (encrypts TOTP secrets at rest)
TOTP_ENCRYPTION_KEY=

# REQUIRED — API key used by company systems to call
#   POST /api/auth/login-request, GET /api/auth/login-request/:id,
#   POST /api/totp/verify, POST /api/recovery/verify
# Send as header:  X-API-Key: <value>
COMPANY_API_KEY=

# TOTP issuer label shown in the app
TOTP_ISSUER=MR ROKESH

# Security tuning
LOGIN_CHALLENGE_TTL_SECONDS=60
ENROLLMENT_SESSION_TTL_SECONDS=600
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Push: Android (Firebase Cloud Messaging via firebase-admin) ---------
# REQUIRED for Android push. Firebase console → Project settings →
# Service accounts → Generate new private key. Paste the JSON base64-encoded:
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Push: iOS (direct APNs, token-based .p8 auth) ------------------------
# REQUIRED for iOS push. Apple Developer → Keys → create key with APNs enabled.
APNS_KEY_ID=
APNS_TEAM_ID=
# Contents of AuthKey_XXXX.p8 base64-encoded
APNS_PRIVATE_KEY_BASE64=
# Must equal ios.bundleIdentifier in frontend/app.config.ts
APNS_BUNDLE_ID=com.mrrokesh.authenticator
# true for EAS "development" builds / expo run:ios (sandbox APNs);
# false for "preview" (ad-hoc), TestFlight and App Store builds
APNS_USE_SANDBOX=true

# --- First admin (used by: npm run seed:admin) ---------------------------
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
