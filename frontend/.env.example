# REQUIRED — backend base URL. Must be https:// for release builds.
# For a physical phone in development use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000

# REQUIRED for push — your EAS project id (run `npx eas-cli@latest init`, it prints/sets this)
EAS_PROJECT_ID=

# REQUIRED for Android push — path to google-services.json from the Firebase console
# (Project settings → Your apps → Android app with package com.mrrokesh.authenticator).
# On EAS, upload it as a file environment variable named GOOGLE_SERVICES_JSON instead.
GOOGLE_SERVICES_JSON=./google-services.json

# iOS push: no file needed here. Run `npx eas-cli@latest credentials` (or let `eas build`
# prompt you) to create/upload the APNs key for bundle id com.mrrokesh.authenticator.
# The SAME .p8 key goes into backend/.env (APNS_KEY_ID / APNS_TEAM_ID / APNS_PRIVATE_KEY_BASE64).
